# Copier vers .env (chmod 600) puis générer votre propre clé privée :
#   openssl rand -hex 32
ZAIMULE_RELAY_ACCESS_KEY=

# Uniquement si vous utilisez le profil Caddy intégré (`docker compose --profile tls up -d`) :
# RELAY_DOMAIN=relay.votre-domaine.fr
# ACME_EMAIL=vous@votre-domaine.fr

# Limites optionnelles :
# ZAIMULE_MAX_ROOMS=64
# ZAIMULE_MAX_PEERS_PER_ROOM=8
# ZAIMULE_MAX_CONNECTIONS=128
# ZAIMULE_MAX_CONN_PER_IP=6
# ZAIMULE_MAX_FRAMES_PER_SEC=600
# ZAIMULE_MAX_FRAME_BYTES=65536
