{
    email {$ACME_EMAIL}
}

{$RELAY_DOMAIN} {
    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "no-referrer"
        -Server
    }
    request_body {
        max_size 64KB
    }
    reverse_proxy zaimule-relay:3000 {
        flush_interval -1
    }
}
